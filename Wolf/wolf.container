[Unit]
Description=Wolf / Games On Whales
# No network-online.target: wolf's user manager has none; quadlet already orders
# after podman-user-wait-network-online.service.
Requires=podman.socket pulseaudio.service nvidia-driver-populate.service
After=podman.socket pulseaudio.service nvidia-driver-populate.service
BindsTo=pulseaudio.service

# Give up after 5 failed starts in 2 min (RestartSec=5 can't hit the default 10s window)
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
TimeoutStartSec=900
ExecStartPre=-/usr/bin/podman rm --force WolfPulseAudio
Restart=on-failure
RestartSec=5
ExecStartPre=/usr/bin/timeout 30 /bin/sh -c 'vol=$(podman volume inspect pulse-socket-vol --format "{{.Mountpoint}}"); until test -S "$vol/pulse-socket"; do sleep 0.5; done'

[Container]
AutoUpdate=registry
ContainerName=%p
HostName=%p
# Minimal image (no embedded PulseAudio/supervisord), built by build-wolf
Image=localhost/gow/wolf:minimal
Network=host

# Rootless: run as the image's `wolf` user (uid/gid 990) and skip the GOW
# root-only init + gosu. keep-id maps it to the host wolf user, so files in
# /etc/wolf and the podman socket line up; keep-groups passes on the host
# wolf user's render/input/video groups for device access.
Exec=--rootless
UserNS=keep-id:uid=990,gid=990
GroupAdd=keep-groups
DropCapability=ALL

# No --device-cgroup-rule: rootless podman rejects it (no device cgroup control
# in a user namespace); device access is by file permissions + keep-groups.
# No custom SELinux type either: container_use_devices.process isn't in the
# loaded policy (crun fails on it). Runs as container_t; see TESTING-rootless.md
# if uinput/uhid hit AVC denials.
PodmanArgs=--ipc=host

AddDevice=/dev/dri
AddDevice=/dev/uinput
AddDevice=/dev/uhid
# NVIDIA via CDI (/var/run/cdi/nvidia.yaml): device nodes + driver libraries,
# ldcache hook included. The driver volume needs the root-only GOW init, which
# --rootless skips; it's still handed to app containers (NVIDIA_DRIVER_VOLUME_NAME).
AddDevice=nvidia.com/gpu=all

# Replaced /dev bind with read-only /run/udev for device discovery
Volume=/run/udev:/run/udev:ro
# Read-Write mount for Wolf persistent configuration
Volume=/etc/wolf/:/etc/wolf:z
# The wolf user's own (rootless) podman socket; app containers run there too
Volume=%t/podman/podman.sock:/var/run/docker.sock
Volume=pulse-socket-vol:/tmp/pulse

Environment=WOLF_STOP_CONTAINER_ON_EXIT=TRUE
Environment=NVIDIA_DRIVER_VOLUME_NAME=nvidia-driver-vol
# renderD128 is the NVIDIA card on this host (ls -l /sys/class/drm/renderD*/device/driver)
Environment=WOLF_RENDER_NODE=/dev/dri/renderD128
Environment=PULSE_SERVER=unix:/tmp/pulse/pulse-socket

# No [Install] section: Wolf runs on demand (`just wolf start` / `stop` /
# `toggle`). `just wolf autostart on` adds a drop-in that restores boot start.
