[Unit]
Description=PulseAudio server for Wolf/Games On Whales
After=podman.socket
Requires=podman.socket
# Give up after 5 failed starts in 2 min (RestartSec=5 can't hit the default 10s window)
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Restart=on-failure
RestartSec=5

[Container]
AutoUpdate=registry
ContainerName=%p
HostName=%p
Image=ghcr.io/games-on-whales/pulseaudio:master

# No network needed at all - audio moves over a unix socket/shared memory,
# never touches a socket that needs host networking or even a bridge.
Network=none

DropCapability=ALL
# SYS_NICE lets PA's mixing thread run at elevated scheduling priority so it
# doesn't glitch under load. This is the only capability it needs.
AddCapability=CAP_SYS_NICE

# Run as the image's unprivileged 'ubuntu' user (uid/gid 1000) instead of
# container-root. The upstream /entrypoint.sh always ends in
# `gosu $UNAME startup.sh`, which needs CAP_SETUID/CAP_SETGID even to
# "switch" to root, so bypass it and exec the startup script directly.
# None of its cont-init.d steps apply here (no user setup, no devices, no GPU).
User=1000
Group=1000
Entrypoint=/opt/gow/startup.sh
# HOME defaults to /root, which uid 1000 can't write; startup.sh and
# pulseaudio keep their ~/.config/pulse state under it.
Environment=HOME=/tmp/home

# :U chowns the volume to uid 1000 so pulseaudio can create its socket there.
# The socket is created 0777 (auth-anonymous=1), so Wolf can still connect.
Volume=pulse-socket-vol:/tmp/pulse:U

Environment=PULSE_SERVER=unix:/tmp/pulse/pulse-socket
