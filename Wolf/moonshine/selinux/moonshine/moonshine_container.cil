; Moonshine's own container: gpu_container (apps/gpu_container.cil) plus the bus
; proxy's socket, the one peer outside the container it may connect to
; (moonshine.te). No other container type may reach the proxy.
;
; Use: SecurityLabelType=moonshine_container.process
(block moonshine_container
	(blockinherit gpu_container)

	(allow process moonshine_bus_t (unix_stream_socket (connectto)))

	; The app container (moonshine-launch-steam.sh) connects to moonshine's
	; Wayland, Xwayland and PulseAudio sockets in the shared volumes. Only
	; connectto: no file, dir or process access to moonshine.
	(allow gow_sandbox.process process (unix_stream_socket (connectto)))

	; Moonshine (window → game, by walking /proc/<pid>/stat and cmdline) and
	; Xwayland (client cmdline) read the app's /proc entries in the shared PID
	; namespace. One way only: the app gets nothing of moonshine's.
	; Denied silently otherwise (dontaudit).
	(allow process gow_sandbox.process (dir (getattr search)))
	(allow process gow_sandbox.process (file (getattr open read)))

	; /dev/uinput and /dev/uhid, for the virtual pads, keyboard and mouse.
	; /dev/uinput shares event_device_t with /dev/input/event*, but only the
	; nodes in the quadlet's AddDevice= exist in the container.
	(allow process event_device_t (chr_file (getattr open read write ioctl)))
	(allow process uhid_device_t (chr_file (getattr open read write ioctl)))
)
