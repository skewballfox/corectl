policy_module(moonshine, 1.0.0)

########################################
#
# moonshine-bus-proxy runs in its own domain so its socket carries a label
# that the moonshine container can be allowed to connect to. Containers may
# not connect to unconfined_t sockets, and allowing that would reach every
# abstract socket on the host (moonshine shares the host network namespace).
# The moonshine container's type grants the connect (moonshine_container.cil).
#
# The proxy is trusted host code holding the service user's real session
# bus, so the domain itself is unconfined.

gen_require(`
	type unconfined_t;
	role unconfined_r;
	class dbus send_msg;
	class filesystem associate;
')

type moonshine_bus_t;
domain_type(moonshine_bus_t)
corecmd_bin_entry_type(moonshine_bus_t)
unconfined_domain(moonshine_bus_t)
role unconfined_r types moonshine_bus_t;

# systemd --user starts the proxy with SELinuxContext= (and NoNewPrivileges=)
allow unconfined_t moonshine_bus_t:process transition;
allow unconfined_t moonshine_bus_t:process2 nnp_transition;

# The proxy calls systemd --user over the session bus, and systemd replies
allow moonshine_bus_t unconfined_t:dbus send_msg;
allow unconfined_t moonshine_bus_t:dbus send_msg;

########################################
#
# Game libraries: /var/mnt/games (moonshine.fc) and every disk mounted under
# it with context=system_u:object_r:moonshine_games_t:s0. The Steam container
# may write them (gow_sandbox.cil), moonshine's may only read them
# (moonshine_container.cil). Both bind /var/mnt/games, and podman's :ro covers
# only the bind itself, not the disks mounted under it, so this type is what
# keeps moonshine read-only there. container_file_t would not: every
# container type may write it.
#
# The attributes container_file_t has for the same use: a file type that is
# also a filesystem's label (context=) and a mountpoint.

type moonshine_games_t;
files_mountpoint(moonshine_games_t)
fs_noxattr_type(moonshine_games_t)
allow moonshine_games_t self:filesystem associate;
